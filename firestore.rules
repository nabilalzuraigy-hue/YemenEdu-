rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    match /test/{testId} { allow read: if true; }
    match /super_admins/{adminId} { allow read: if true; allow write: if isValidId(adminId); }
    match /schools/{schoolId} { allow read: if true; allow write: if isValidId(schoolId); }
    match /codes/{codeId} { allow read: if true; allow write: if isValidId(codeId); }
    match /registeredCodes/{codeId} { allow read: if true; allow write: if isValidId(codeId); }
    match /activation_codes/{codeId} { allow read: if true; allow write: if isValidId(codeId); }
    match /students/{studentId} { allow read: if true; allow write: if isValidId(studentId); }
    match /teachers/{teacherId} { allow read: if true; allow write: if isValidId(teacherId); }
    match /questions/{questionId} { allow read: if true; allow write: if isValidId(questionId); }
    match /announcements/{announcementId} { allow read: if true; allow write: if isValidId(announcementId); }
    match /circulars/{circularId} { allow read: if true; allow write: if isValidId(circularId); }
    match /submissions/{submissionId} { allow read: true; allow write: if isValidId(submissionId); }
    match /grades/{gradeId} { allow read: if true; allow write: if isValidId(gradeId); }
    match /answered_questions/{answeredId} { allow read: if true; allow write: if isValidId(answeredId); }
    match /textbooks/{bookId} { allow read: if true; allow write: if isValidId(bookId); }
    match /curricula/{gradeId} { allow read: if true; allow write: if isValidId(gradeId); }
    match /term_results/{resultId} { allow read: if true; allow write: if isValidId(resultId); }
    match /monthlyReports/{reportId} { allow read: if true; allow write: if isValidId(reportId); }
    match /monthlyGradebooks/{recordId} { allow read: if true; allow write: if isValidId(recordId); }
    match /recommendations/{recId} { allow read: if true; allow write: if isValidId(recId); }
    match /attendance/{id} { allow read: if true; allow write: if isValidId(id); }
    match /classSchedules/{id} { allow read: if true; allow write: if isValidId(id); }
    match /supervisorActivities/{id} { allow read: if true; allow write: if isValidId(id); }
    match /inAppNotifications/{id} { allow read: if true; allow write: if isValidId(id); }
  }
}
